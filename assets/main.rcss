/* Native 1024x768 layout. Values map directly to physical pixels. */
* {
    box-sizing: border-box;
}

body {
    width: 100%;
    height: 100%;
    margin: 0;
    color: #171611;
    background-color: #f3efe5;
    font-family: "Alibaba PuHuiTi 3.0";
    font-size: 28px;
}

button {
    font-family: "Alibaba PuHuiTi 3.0";
}

h1,
h2,
p {
    display: block;
    margin: 0;
}

#screen {
    width: 100%;
    height: 100%;
    padding: 20px 40px 18px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background-color: #f3efe5;
    decorator: vertical-gradient(#f8f5ed #eee8dc);
}

.status-bar {
    height: 58px;
    flex: 0 0 58px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px #d7d0c2;
}

.system-mark,
.device-status {
    display: flex;
    align-items: center;
}

.system-mark {
    gap: 11px;
    color: #29271f;
    font-size: 22px;
    letter-spacing: 4px;
}

.system-dot {
    width: 10px;
    height: 10px;
    background-color: #6246c7;
    border-radius: 5px;
}

.device-status {
    gap: 11px;
    color: #29271f;
    font-size: 24px;
}

#clock {
    width: 72px;
    text-align: right;
}

.status-separator {
    width: 1px;
    height: 20px;
    margin: 0 5px;
    background-color: #c9c1b2;
}

.battery-shell {
    width: 38px;
    height: 18px;
    padding: 2px;
    border: 2px #29271f;
    border-radius: 4px;
}

#battery-fill {
    width: 70%;
    height: 100%;
    display: block;
    background-color: #6246c7;
}

#battery-text {
    width: 52px;
    color: #5f5a4e;
    font-size: 21px;
}

#home-view {
    min-height: 0;
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
}

.section-heading {
    height: 112px;
    flex: 0 0 112px;
    padding-top: 17px;
    text-align: center;
}

.eyebrow {
    color: #8b8476;
    font-size: 16px;
    line-height: 1;
    letter-spacing: 4px;
}

h1 {
    margin-top: 7px;
    color: #171611;
    font-size: 39px;
    line-height: 1;
    letter-spacing: 1px;
}

.subtitle {
    margin-top: 6px;
    color: #817a6d;
    font-size: 17px;
    line-height: 1;
    letter-spacing: 2px;
}

#console-roll {
    width: 944px;
    height: 471px;
    flex: 0 0 471px;
    position: relative;
    overflow: hidden;
}

.selection-backdrop {
    position: absolute;
    left: 265px;
    top: 26px;
    width: 414px;
    height: 414px;
    background-color: #e5ddf5;
    border: 1px #d2c5ec;
    border-radius: 207px;
}

.model-card {
    position: absolute;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: #6f695d;
    background-color: transparent;
    border: 0px transparent;
    opacity: 0.48;
    transition: left 0.18s, top 0.18s, width 0.18s, height 0.18s, opacity 0.18s, color 0.18s;
}

.model-card.slot-left {
    left: 4px;
    top: 139px;
    width: 224px;
    height: 286px;
}

.model-card.slot-center {
    left: 252px;
    top: 0px;
    width: 440px;
    height: 468px;
    color: #171611;
    opacity: 1;
}

.model-card.slot-right {
    left: 716px;
    top: 139px;
    width: 224px;
    height: 286px;
}

.console-image {
    width: 224px;
    height: 224px;
    display: block;
}

.slot-center .console-image {
    width: 424px;
    height: 424px;
}

.model-short-name {
    margin-top: 5px;
    font-size: 18px;
    line-height: 1;
    letter-spacing: 1px;
    white-space: nowrap;
}

.slot-center .model-short-name {
    margin-top: -1px;
    font-size: 24px;
    letter-spacing: 2px;
}

.position-dots {
    height: 22px;
    flex: 0 0 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
}

.position-dot {
    width: 7px;
    height: 7px;
    display: block;
    background-color: #c9c1b3;
    border-radius: 4px;
}

.position-dot.active {
    width: 24px;
    background-color: #6246c7;
}

.control-bar {
    height: 67px;
    flex: 0 0 67px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 42px;
    border-top: 1px #d7d0c2;
}

.control-hint {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #716a5f;
    font-size: 21px;
}

.primary-action {
    color: #171611;
}

.secondary-action {
    margin-left: auto;
}

.keycap {
    height: 34px;
    display: block;
    color: #ffffff;
    background-color: #27251f;
    border: 1px #454138;
    font-size: 18px;
    line-height: 30px;
    text-align: center;
}

.keycap-wide {
    min-width: 70px;
    padding: 0 10px;
    border-radius: 8px;
}

.keycap-round {
    width: 34px;
    border-radius: 17px;
}

.primary-action .keycap {
    background-color: #6246c7;
    border-color: #755cd1;
}

.keycap-muted {
    color: #5d574d;
    background-color: #dfd8ca;
    border-color: #c8bfae;
}

#detail-view {
    min-height: 0;
    flex: 1 1 auto;
    display: none;
    flex-direction: row;
    align-items: center;
}

.detail-copy {
    width: 47%;
    padding-left: 52px;
}

.detail-copy h2 {
    margin-top: 12px;
    color: #171611;
    font-size: 56px;
    line-height: 1.02;
}

#detail-subtitle {
    margin-top: 13px;
    color: #786f62;
    font-size: 19px;
    letter-spacing: 2px;
}

.detail-rule {
    width: 72px;
    height: 5px;
    margin-top: 28px;
    background-color: #6246c7;
}

.detail-message {
    margin-top: 18px;
    color: #70695d;
    font-size: 25px;
}

.detail-art-frame {
    width: 53%;
    height: 540px;
    display: flex;
    align-items: center;
    justify-content: center;
}

#detail-image {
    width: 480px;
    height: 480px;
}

#detail-footer {
    display: none;
    justify-content: space-between;
}

.detail-status {
    color: #938b7d;
    font-size: 18px;
    letter-spacing: 1px;
}
