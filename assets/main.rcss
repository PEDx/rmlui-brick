/* Native 1024x768 layout, translated from Figma nodes 3:2 and 3:7. */
* {
    box-sizing: border-box;
}

body {
    width: 100%;
    height: 100%;
    margin: 0;
    color: #171611;
    background-color: #f3efe5;
    font-family: "Alibaba PuHuiTi 3.0";
    font-size: 22px;
}

button {
    font-family: "Alibaba PuHuiTi 3.0";
}

h1,
p {
    display: block;
    margin: 0;
}

#screen {
    width: 100%;
    height: 100%;
    padding: 14px 40px 18px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background-color: #f3efe5;
    decorator: vertical-gradient(#f8f5ed #eee8dc);
}

.status-bar {
    height: 76px;
    flex: 0 0 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 2px #c8c0b1;
}

.page-mark {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.page-icon {
    width: 32px;
    height: 32px;
    display: block;
}

.library-breadcrumb {
    height: 40px;
    display: none;
    align-items: center;
    gap: 12px;
    color: #1f1d19;
    font-size: 20px;
    letter-spacing: 1px;
}

.breadcrumb-slash {
    color: #8c8679;
}

.game-count {
    height: 38px;
    min-width: 99px;
    padding: 0 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #5b554b;
    background-color: #e8e1d4;
    border-radius: 19px;
    font-size: 15px;
    line-height: 22px;
    letter-spacing: 0;
    text-align: center;
}

.game-count-text {
    height: 22px;
    display: block;
    line-height: 22px;
    white-space: nowrap;
}

.device-status,
.battery-status {
    display: flex;
    align-items: center;
}

.device-status {
    gap: 16px;
    color: #29271f;
    font-size: 24px;
}

.status-icon {
    width: 28px;
    height: 28px;
    display: block;
}

.battery-status {
    gap: 8px;
}

.battery-shell {
    width: 42px;
    height: 20px;
    padding: 2px;
    border: 2px #29271f;
    border-radius: 4px;
}

#battery-fill {
    width: 70%;
    height: 100%;
    display: block;
    background-color: #6246c7;
    border-radius: 2px;
}

#battery-text {
    width: 54px;
    color: #5f5a4e;
    font-size: 22px;
}

#clock {
    width: 64px;
    text-align: right;
}

#home-view,
#library-view {
    width: 944px;
    height: 578px;
    flex: 0 0 578px;
    position: relative;
    overflow: hidden;
}

#home-view {
    display: flex;
    flex-direction: column;
}

#console-roll {
    width: 944px;
    height: 550px;
    flex: 0 0 550px;
    position: relative;
    overflow: hidden;
}

.model-card {
    position: absolute;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    background-color: transparent;
    border: 0px transparent;
    opacity: 0.48;
    transition: left 0.18s, top 0.18s, width 0.18s, height 0.18s, opacity 0.18s;
}

.model-card.slot-left {
    left: 4px;
    top: 139px;
    width: 224px;
    height: 286px;
}

.model-card.slot-center {
    left: 252px;
    top: 50px;
    width: 440px;
    height: 458px;
    padding-top: 20px;
    opacity: 1;
}

.model-card.slot-right {
    left: 716px;
    top: 139px;
    width: 224px;
    height: 286px;
}

.console-image {
    width: 224px;
    height: 224px;
    display: block;
}

.slot-center .console-image {
    width: 360px;
    height: 360px;
}

.console-logo {
    display: block;
    margin-top: 7px;
}

.logo-gb {
    width: 160px;
    height: 29px;
}

.logo-gbc {
    width: 145px;
    height: 60px;
    margin-top: 11px;
}

.logo-gba {
    width: 180px;
    height: 21px;
    margin-top: 10px;
}

.slot-center .logo-gb {
    width: 200px;
    height: 36px;
}

.slot-center .logo-gbc {
    width: 145px;
    height: 60px;
}

.slot-center .logo-gba {
    width: 220px;
    height: 26px;
}

.position-dots {
    width: 944px;
    height: 28px;
    flex: 0 0 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
}

.position-dot {
    width: 7px;
    height: 7px;
    display: block;
    background-color: #c9c1b3;
    border-radius: 4px;
}

.position-dot.active {
    width: 24px;
    background-color: #6246c7;
}

#library-view {
    display: none;
    flex-direction: column;
}

#game-rail {
    width: 944px;
    height: 372px;
    padding-top: 32px;
    display: flex;
    align-items: center;
    gap: 18px;
    overflow: hidden;
}

.game-card {
    width: 218px;
    height: 218px;
    flex: 0 0 218px;
    position: relative;
    margin-top: 0;
    overflow: hidden;
    background-color: #faf8f1;
    border: 1px #d8d1c4;
    border-radius: 18px;
}

.game-card.active {
    width: 229px;
    height: 229px;
    flex-basis: 229px;
    background-color: #6246c7;
    border: 0px transparent;
    border-radius: 19px;
}

.game-cover-frame {
    width: 218px;
    height: 218px;
    position: absolute;
    left: -1px;
    top: -1px;
    overflow: hidden;
    border-radius: 17px;
}

.game-card.active .game-cover-frame {
    width: 217px;
    height: 217px;
    left: 6px;
    top: 6px;
    border-radius: 13px;
}

.game-cover {
    width: 100%;
    height: 100%;
    display: block;
}

.game-card.placeholder {
    background-color: #ece5db;
}

.game-card.active.placeholder {
    background-color: #6246c7;
}

.game-card.placeholder .game-cover-frame {
    left: 22px;
    top: 14px;
    width: 172px;
    height: 172px;
    border-radius: 0;
}

.game-card.active.placeholder .game-cover-frame {
    left: 28px;
    top: 20px;
}

.game-card.placeholder .game-label {
    display: block;
}

.game-label {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 10px;
    display: none;
    color: #4e493f;
    font-size: 14px;
    line-height: 17px;
    text-align: center;
}

#library-empty {
    width: 944px;
    height: 260px;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    color: #716a5f;
    font-size: 21px;
}

#library-empty img {
    width: 48px;
    height: 48px;
}

.game-information {
    width: 944px;
    height: 206px;
    padding-top: 18px;
    border-top: 2px #d2cabc;
}

.game-title-row,
.game-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.game-title-row h1 {
    max-width: 720px;
    color: #29271f;
    font-size: 25px;
    line-height: 34px;
    white-space: nowrap;
    overflow: hidden;
}

#library-position {
    color: #29271f;
    font-size: 21px;
}

.game-meta-row {
    margin-top: 2px;
    color: #756f64;
    font-size: 14px;
    letter-spacing: 1px;
}

#library-message {
    color: #a34b3f;
    font-size: 16px;
    letter-spacing: 0;
}

.control-bar {
    width: 944px;
    height: 82px;
    flex: 0 0 82px;
    display: flex;
    align-items: center;
    padding-top: 0;
    border-top: 2px #c8c0b1;
}

#library-footer {
    display: none;
}

.control-hint {
    display: flex;
    align-items: center;
    gap: 14px;
    color: #716a5f;
    font-size: 23px;
    line-height: 32px;
}

.switch-hint {
    width: 220px;
}

.primary-action {
    color: #171611;
    font-weight: bold;
}

.secondary-action {
    margin-left: auto;
}

.dpad-hint {
    width: 54px;
    height: 54px;
    display: block;
}

.keycap {
    width: 42px;
    height: 42px;
    display: block;
    border-radius: 21px;
    font-size: 20px;
    line-height: 38px;
    text-align: center;
}

.keycap-primary {
    color: #ffffff;
    background-color: #6246c7;
    border: 1px #755cd1;
}

.keycap-muted {
    color: #5d574d;
    background-color: #dfd8ca;
    border: 1px #c8bfae;
}
