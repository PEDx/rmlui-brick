/* Native 1024x768 layout, translated from Figma nodes 3:2 and 3:7. */
* {
    box-sizing: border-box;
}

body {
    width: 100%;
    height: 100%;
    margin: 0;
    color: #171611;
    background-color: #f3efe5;
    font-family: "Alibaba PuHuiTi 3.0";
    font-size: 22px;
}

button {
    font-family: "Alibaba PuHuiTi 3.0";
}

h1,
p {
    display: block;
    margin: 0;
}

#screen {
    width: 100%;
    height: 100%;
    padding: 14px 40px 18px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background-color: #f3efe5;
    decorator: vertical-gradient(#f8f5ed #eee8dc);
}

.status-bar {
    height: 76px;
    flex: 0 0 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 2px #c8c0b1;
}

.page-mark {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.page-icon {
    width: 32px;
    height: 32px;
    display: block;
}

.library-breadcrumb {
    height: 40px;
    display: none;
    align-items: center;
    gap: 12px;
    color: #1f1d19;
    font-size: 20px;
    letter-spacing: 1px;
}

.breadcrumb-slash {
    color: #8c8679;
}

.game-count {
    height: 38px;
    min-width: 99px;
    padding: 0 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #5b554b;
    background-color: #e8e1d4;
    border-radius: 19px;
    font-size: 15px;
    line-height: 22px;
    letter-spacing: 0;
    text-align: center;
}

.game-count-text {
    height: 22px;
    display: block;
    line-height: 22px;
    white-space: nowrap;
}

.device-status,
.battery-status {
    display: flex;
    align-items: center;
}

.device-status {
    gap: 16px;
    color: #29271f;
    font-size: 24px;
}

.status-icon {
    width: 28px;
    height: 28px;
    display: block;
}

.battery-status {
    gap: 8px;
}

.battery-icon-slot {
    width: 42px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.battery-indicator {
    width: 40px;
    height: 28px;
    position: relative;
}

#battery-fill {
    width: 0;
    height: 14px;
    position: absolute;
    left: 3px;
    top: 7px;
    z-index: 1;
    display: block;
    background-color: #6246c7;
    border-radius: 2px;
}

.battery-shell {
    width: 36px;
    height: 20px;
    position: absolute;
    left: 0;
    top: 4px;
    z-index: 2;
    display: block;
    background-color: transparent;
    border: 2px #171611;
    border-radius: 4px;
}

.battery-terminal {
    width: 4px;
    height: 10px;
    position: absolute;
    left: 36px;
    top: 9px;
    z-index: 2;
    display: block;
    background-color: #171611;
    border-radius: 1px;
}

.battery-charge-indicator {
    width: 10px;
    height: 13px;
    position: absolute;
    left: 13px;
    top: 7px;
    z-index: 3;
    display: none;
}

.battery-status.critical #battery-fill {
    background-color: #d84c4c;
}

.battery-status.low #battery-fill {
    background-color: #d28a2e;
}

.battery-status.charging #battery-fill {
    background-color: #2e9d5b;
}

.battery-status.charging .battery-charge-indicator {
    display: block;
}

#battery-text {
    width: 54px;
    color: #5f5a4e;
    font-size: 22px;
}

#clock {
    width: 64px;
    text-align: right;
}

#home-view,
#library-view {
    width: 944px;
    height: 578px;
    flex: 0 0 578px;
    position: relative;
    overflow: hidden;
}

#home-view {
    display: flex;
    flex-direction: column;
}

#console-roll {
    width: 944px;
    height: 550px;
    flex: 0 0 550px;
    position: relative;
    overflow: hidden;
}

.model-card {
    position: absolute;
    left: -400px;
    top: 139px;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    background-color: transparent;
    border: 0px transparent;
    opacity: 0.48;
    transition: left 0.18s, top 0.18s, width 0.18s, height 0.18s, opacity 0.18s;
}

/* Apply the restored slot assignment for one complete frame before enabling
   navigation transitions. This prevents the saved model from animating out of
   the static GBC defaults when the desktop first opens. */
#console-roll.initializing .model-card {
    transition: none;
}

.model-card.carousel-snap {
    transition: none;
}

.model-card.slot-off-left,
.model-card.slot-off-right {
    top: 139px;
    width: 224px;
    height: 286px;
    opacity: 0.48;
}

.model-card.slot-off-left {
    left: -244px;
}

.model-card.slot-off-right {
    left: 964px;
}

.model-card.slot-left {
    left: 4px;
    top: 139px;
    width: 224px;
    height: 286px;
}

.model-card.slot-center {
    left: 252px;
    top: 50px;
    width: 440px;
    height: 458px;
    padding-top: 20px;
    opacity: 1;
}

.model-card.slot-right {
    left: 716px;
    top: 139px;
    width: 224px;
    height: 286px;
}

.console-image {
    width: 224px;
    height: 224px;
    display: block;
}

.slot-center .console-image {
    width: 360px;
    height: 360px;
}

.console-logo {
    display: block;
    margin-top: 7px;
}

.logo-gb {
    width: 160px;
    height: 29px;
}

.logo-gbc {
    width: 145px;
    height: 60px;
    margin-top: 11px;
}

.logo-gba {
    width: 180px;
    height: 21px;
    margin-top: 10px;
}

.logo-sfc {
    width: 190px;
    height: 54px;
    margin-top: 4px;
}

.logo-md {
    width: 190px;
    height: 46px;
    margin-top: 7px;
}

.logo-gg {
    width: 82px;
    height: 80px;
    margin-top: -2px;
}

.slot-center .logo-gb {
    width: 200px;
    height: 36px;
}

.slot-center .logo-gbc {
    width: 145px;
    height: 60px;
}

.slot-center .logo-gba {
    width: 220px;
    height: 26px;
}

.slot-center .logo-sfc {
    width: 250px;
    height: 72px;
    margin-top: -2px;
}

.slot-center .logo-md {
    width: 250px;
    height: 60px;
    margin-top: 4px;
}

.slot-center .logo-gg {
    width: 104px;
    height: 101px;
    margin-top: -10px;
}

.position-dots {
    width: 944px;
    height: 28px;
    flex: 0 0 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
}

.position-dot {
    width: 7px;
    height: 7px;
    display: block;
    background-color: #c9c1b3;
    border-radius: 4px;
}

.position-dot.active {
    width: 24px;
    background-color: #6246c7;
}

#library-view {
    display: none;
    flex-direction: column;
}

#game-rail {
    width: 944px;
    height: 372px;
    position: relative;
    overflow: hidden;
}

/* Keep one buffered card on either side of the four-card viewport. Moving the
   whole track by one card step makes page changes read as continuous scrolling
   instead of replacing all four covers in place. */
.game-track {
    width: 1398px;
    height: 228px;
    position: absolute;
    left: -231px;
    top: 88px;
    display: flex;
    gap: 18px;
    overflow: visible;
    /* Position is eased frame-by-frame by DesktopController so the animation
       remains smooth and visible on the Brick's minimal renderer. */
    transition: none;
}

/* While the covers are moving, keep the incoming active card neutral. Once it
   reaches the second slot, removing this class lets the card enlarge and its
   purple selection ring fade in at the final position. */
.game-track.scrolling .game-card.active .game-card-surface {
    width: 218px;
    height: 218px;
    left: 0;
    top: 0;
    transition: none;
}

.game-track.scrolling .game-selection-ring {
    opacity: 0;
    transition: none;
}

/* Used for the invisible ring-buffer reset after a card has left the viewport. */
.game-track.snapping,
.game-track.snapping .game-card-surface,
.game-track.snapping .game-selection-ring {
    transition: none;
}

/* The flex item is only a stable layout slot. Selection never changes this
   element's dimensions, so moving between games cannot reflow the rail. */
.game-card {
    width: 218px;
    height: 218px;
    flex: 0 0 218px;
    position: relative;
    margin-top: 5px;
    overflow: visible;
    background-color: transparent;
    border: 0px transparent;
}

.game-card.active {
    z-index: 4;
}

.game-card.buffer-empty {
    opacity: 0;
}

/* Scale the visual surface with dimensions instead of CSS transform, which is
   not implemented by the current renderer. Because this layer is absolute,
   the animated size does not participate in flex layout. */
.game-card-surface {
    width: 218px;
    height: 218px;
    position: absolute;
    left: 0;
    top: 0;
    overflow: visible;
    transition: left 0.16s cubic-out, top 0.16s cubic-out, width 0.16s cubic-out, height 0.16s cubic-out;
}

.game-card.active .game-card-surface {
    width: 228px;
    height: 228px;
    left: -5px;
    top: -5px;
}

/* The cover stays inside the six-pixel frame. RmlUi currently only supports a
   rectangular scissor, so placing the square image below the frame lets the
   rounded frame cover its four corners without relying on rounded clipping. */
.game-cover-frame {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 6px;
    bottom: 6px;
    overflow: hidden;
}

.game-cover {
    width: 100%;
    height: 100%;
    display: block;
}

/* Both frames use identical geometry. The neutral frame permanently hides the
   square image corners; the purple frame then fades in exactly on top of it. */
.game-corner-frame,
.game-selection-ring {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    display: block;
    border: 6px #e8e1d4;
    border-radius: 18px;
    pointer-events: none;
}

.game-corner-frame {
    z-index: 2;
}

.game-selection-ring {
    z-index: 3;
    opacity: 0;
    border-color: #6246c7;
    transition: opacity 0.16s cubic-out;
}

.game-card.active .game-selection-ring {
    opacity: 1;
}

.game-card.placeholder .game-cover-frame {
    left: 23px;
    top: 17px;
    right: auto;
    bottom: auto;
    width: 172px;
    height: 172px;
}

.game-card.placeholder .game-label {
    display: block;
}

.game-label {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 10px;
    z-index: 4;
    display: none;
    color: #4e493f;
    font-size: 14px;
    line-height: 17px;
    text-align: center;
}

#library-empty {
    width: 944px;
    height: 260px;
    position: absolute;
    left: 0;
    top: 56px;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    color: #716a5f;
    font-size: 21px;
}

#library-empty img {
    width: 48px;
    height: 48px;
}

.game-information {
    width: 944px;
    height: 206px;
    padding-top: 18px;
    border-top: 2px #d2cabc;
}

.game-title-row,
.game-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.game-title-row h1 {
    max-width: 720px;
    color: #29271f;
    font-size: 25px;
    line-height: 34px;
    white-space: nowrap;
    overflow: hidden;
}

#library-position {
    color: #29271f;
    font-size: 21px;
}

.game-meta-row {
    margin-top: 2px;
    color: #756f64;
    font-size: 14px;
    letter-spacing: 1px;
}

#library-message {
    color: #a34b3f;
    font-size: 16px;
    letter-spacing: 0;
}

.control-bar {
    width: 944px;
    height: 82px;
    flex: 0 0 82px;
    display: flex;
    align-items: center;
    padding-top: 0;
    border-top: 2px #c8c0b1;
}

#library-footer {
    display: none;
}

.control-hint {
    display: flex;
    align-items: center;
    gap: 14px;
    color: #716a5f;
    font-size: 23px;
    line-height: 32px;
}

.switch-hint {
    width: 220px;
}

.primary-action {
    color: #171611;
    font-weight: bold;
}

.secondary-action {
    margin-left: auto;
}

.dpad-hint {
    width: 54px;
    height: 54px;
    display: block;
}

.keycap {
    width: 42px;
    height: 42px;
    display: block;
    border-radius: 21px;
    font-size: 20px;
    line-height: 38px;
    text-align: center;
}

.keycap-primary {
    color: #ffffff;
    background-color: #6246c7;
    border: 1px #755cd1;
}

.keycap-muted {
    color: #5d574d;
    background-color: #dfd8ca;
    border: 1px #c8bfae;
}
