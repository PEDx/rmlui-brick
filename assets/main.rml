<rml>
<head>
    <title>TrimUI Brick RmlUi Prototype</title>
    <link type="text/rcss" href="main.rcss"/>
</head>
<body>
    <div id="screen">
        <header>
            <div class="brand">
                <h1>TRIMUI</h1>
                <p class="subtitle">RmlUi 掌机界面原型</p>
            </div>
            <div class="metrics">
                <span id="fps">等待帧率…</span>
                <span class="dot">●</span>
                <span>1024 × 768</span>
                <span class="dot">●</span>
                <span id="density">2× DP</span>
            </div>
        </header>

        <main>
            <aside>
                <p class="eyebrow">LIBRARY</p>
                <button id="item-recent" class="nav-item">
                    <span class="icon">●</span><span>最近游玩</span><span class="count">03</span>
                </button>
                <button id="item-games" class="nav-item">
                    <span class="icon">◆</span><span>游戏库</span><span class="count">24</span>
                </button>
                <button id="item-apps" class="nav-item">
                    <span class="icon">■</span><span>应用</span><span class="count">08</span>
                </button>
                <button id="item-favorites" class="nav-item">
                    <span class="icon">★</span><span>收藏</span><span class="count">11</span>
                </button>
                <button id="item-settings" class="nav-item">
                    <span class="icon">●</span><span>设置</span><span class="count">›</span>
                </button>
            </aside>

            <section class="content">
                <div class="hero">
                    <p class="eyebrow accent">RENDER CHECK</p>
                    <h2>为高密度掌机<br/>重新设计界面</h2>
                    <p class="description">布局、中文、输入与透明混合都已通过实机验证。</p>
                    <div class="chips">
                        <span>2× DP</span>
                        <span>原生 1024 × 768</span>
                        <span>RCSS FLEX</span>
                    </div>
                </div>

                <div class="cards">
                    <div class="card cyan"><span>01</span><strong>清晰文字</strong><small>16dp 正文基准</small></div>
                    <div class="card violet"><span>02</span><strong>舒适焦点</strong><small>78px 可选区域</small></div>
                    <div class="card amber"><span>03</span><strong>原生渲染</strong><small>PowerVR GLES2</small></div>
                </div>
            </section>
        </main>

        <footer>
            <div id="status">方向键选择 · A 确认 · B 退出</div>
            <div id="renderer">正在读取 SDL renderer…</div>
        </footer>
    </div>
</body>
</rml>
