<rml>
<head>
    <title>Brick Game Library</title>
    <link type="text/rcss" href="main.rcss"/>
</head>
<body>
    <div id="screen">
        <header class="status-bar">
            <div id="home-mark" class="page-mark">
                <img class="page-icon" src="ui/home.png"/>
            </div>
            <div id="library-mark" class="library-breadcrumb">
                <img class="page-icon" src="ui/folder.png"/>
                <span class="breadcrumb-slash">/</span>
                <span id="library-system">GAME BOY COLOR</span>
                <span class="game-count"><span id="library-count" class="game-count-text">0 GAMES</span></span>
            </div>
            <div class="device-status">
                <img class="status-icon" src="ui/bluetooth.png"/>
                <img class="status-icon" src="ui/wifi.png"/>
                <div id="battery-status" class="battery-status">
                    <div class="battery-icon-slot">
                        <div class="battery-indicator">
                            <span id="battery-fill"></span>
                            <span class="battery-shell"></span>
                            <span class="battery-terminal"></span>
                            <img class="battery-charge-indicator" src="ui/battery-charging-mark.png"/>
                        </div>
                    </div>
                    <span id="battery-text">--%</span>
                </div>
                <span id="clock">--:--</span>
            </div>
        </header>

        <main id="home-view">
            <div id="console-roll">
                <button id="model-gb" class="model-card model-gb slot-left">
                    <img class="console-image" src="icons/gb-dmg-simple.png"/>
                    <img class="console-logo logo-gb" src="ui/logo-gb.png"/>
                </button>
                <button id="model-gbc" class="model-card model-gbc slot-center selected">
                    <img class="console-image" src="icons/gbc-atomic-purple-simple.png"/>
                    <img class="console-logo logo-gbc" src="ui/logo-gbc.png"/>
                </button>
                <button id="model-gba" class="model-card model-gba slot-right">
                    <img class="console-image" src="icons/gba-indigo-simple.png"/>
                    <img class="console-logo logo-gba" src="ui/logo-gba.png"/>
                </button>
                <button id="model-sfc" class="model-card model-sfc">
                    <img class="console-image" src="icons/snes-classic-simple.png"/>
                    <img class="console-logo logo-sfc" src="ui/logo-snes.png"/>
                </button>
            </div>
            <div class="position-dots">
                <span id="position-0" class="position-dot"></span>
                <span id="position-1" class="position-dot active"></span>
                <span id="position-2" class="position-dot"></span>
                <span id="position-3" class="position-dot"></span>
            </div>
        </main>

        <main id="library-view">
            <div id="game-rail">
                <div id="game-track" class="game-track">
                <div id="game-card-0" class="game-card">
                    <div class="game-card-surface">
                        <div class="game-cover-frame"><img id="game-cover-0" class="game-cover" src="icons/gbc-atomic-purple-simple.png"/></div>
                        <div class="game-corner-frame"></div>
                        <div class="game-selection-ring"></div>
                        <span id="game-label-0" class="game-label"></span>
                    </div>
                </div>
                <div id="game-card-1" class="game-card">
                    <div class="game-card-surface">
                        <div class="game-cover-frame"><img id="game-cover-1" class="game-cover" src="icons/gbc-atomic-purple-simple.png"/></div>
                        <div class="game-corner-frame"></div>
                        <div class="game-selection-ring"></div>
                        <span id="game-label-1" class="game-label"></span>
                    </div>
                </div>
                <div id="game-card-2" class="game-card">
                    <div class="game-card-surface">
                        <div class="game-cover-frame"><img id="game-cover-2" class="game-cover" src="icons/gbc-atomic-purple-simple.png"/></div>
                        <div class="game-corner-frame"></div>
                        <div class="game-selection-ring"></div>
                        <span id="game-label-2" class="game-label"></span>
                    </div>
                </div>
                <div id="game-card-3" class="game-card">
                    <div class="game-card-surface">
                        <div class="game-cover-frame"><img id="game-cover-3" class="game-cover" src="icons/gbc-atomic-purple-simple.png"/></div>
                        <div class="game-corner-frame"></div>
                        <div class="game-selection-ring"></div>
                        <span id="game-label-3" class="game-label"></span>
                    </div>
                </div>
                <div id="game-card-4" class="game-card">
                    <div class="game-card-surface">
                        <div class="game-cover-frame"><img id="game-cover-4" class="game-cover" src="icons/gbc-atomic-purple-simple.png"/></div>
                        <div class="game-corner-frame"></div>
                        <div class="game-selection-ring"></div>
                        <span id="game-label-4" class="game-label"></span>
                    </div>
                </div>
                <div id="game-card-5" class="game-card">
                    <div class="game-card-surface">
                        <div class="game-cover-frame"><img id="game-cover-5" class="game-cover" src="icons/gbc-atomic-purple-simple.png"/></div>
                        <div class="game-corner-frame"></div>
                        <div class="game-selection-ring"></div>
                        <span id="game-label-5" class="game-label"></span>
                    </div>
                </div>
                </div>
                <div id="library-empty">
                    <img src="ui/folder.png"/>
                    <span>请把 ROM 放入对应的 GB、GBC、GBA 或 SFC 目录</span>
                </div>
            </div>
            <div class="game-information">
                <div class="game-title-row">
                    <h1 id="library-title">选择一个游戏</h1>
                    <span id="library-position">0 / 0</span>
                </div>
                <div class="game-meta-row">
                    <span id="library-message"></span>
                    <span id="library-core">GAMBATTE · GAME BOY COLOR</span>
                </div>
            </div>
        </main>

        <footer id="home-footer" class="control-bar">
            <div class="control-hint switch-hint">
                <img class="dpad-hint" src="ui/dpad.png"/>
                <span>切换机型</span>
            </div>
            <div class="control-hint primary-action">
                <span class="keycap keycap-primary">A</span>
                <span>进入游戏库</span>
            </div>
            <div class="control-hint secondary-action">
                <span class="keycap keycap-muted">B</span>
                <span>退出</span>
            </div>
        </footer>

        <footer id="library-footer" class="control-bar">
            <div class="control-hint switch-hint">
                <img class="dpad-hint" src="ui/dpad.png"/>
                <span>选择游戏</span>
            </div>
            <div class="control-hint primary-action">
                <span class="keycap keycap-primary">A</span>
                <span>开始游戏</span>
            </div>
            <div class="control-hint secondary-action">
                <span class="keycap keycap-muted">B</span>
                <span>返回</span>
            </div>
        </footer>
    </div>
</body>
</rml>
