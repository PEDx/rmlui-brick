<rml>
<head>
    <title>Brick Handheld Library</title>
    <link type="text/rcss" href="main.rcss"/>
</head>
<body>
    <div id="screen">
        <header class="status-bar">
            <div class="system-mark">
                <span class="system-dot"></span>
                <span>BRICK</span>
            </div>
            <div class="device-status">
                <span id="clock">--:--</span>
                <span class="status-separator"></span>
                <div class="battery-shell"><span id="battery-fill"></span></div>
                <span id="battery-text">--%</span>
            </div>
        </header>

        <main id="home-view">
            <div class="section-heading">
                <p class="eyebrow">CHOOSE YOUR SYSTEM</p>
                <h1 id="selected-title">GAME BOY COLOR</h1>
                <p id="selected-subtitle" class="subtitle">1998 · COLOR IN YOUR HANDS</p>
            </div>

            <div id="console-roll">
                <div class="selection-backdrop"></div>

                <button id="model-gb" class="model-card model-gb slot-left">
                    <img class="console-image" src="icons/gb-dmg-simple.png"/>
                    <span class="model-short-name">GAME BOY</span>
                </button>

                <button id="model-gbc" class="model-card model-gbc slot-center selected">
                    <img class="console-image" src="icons/gbc-atomic-purple-simple.png"/>
                    <span class="model-short-name">GAME BOY COLOR</span>
                </button>

                <button id="model-gba" class="model-card model-gba slot-right">
                    <img class="console-image" src="icons/gba-indigo-simple.png"/>
                    <span class="model-short-name">GAME BOY ADVANCE</span>
                </button>
            </div>

            <div class="position-dots">
                <span id="position-0" class="position-dot"></span>
                <span id="position-1" class="position-dot active"></span>
                <span id="position-2" class="position-dot"></span>
            </div>
        </main>

        <main id="detail-view">
            <div class="detail-copy">
                <p class="eyebrow">SELECTED SYSTEM</p>
                <h2 id="detail-title">GAME BOY COLOR</h2>
                <p id="detail-subtitle">1998 · COLOR IN YOUR HANDS</p>
                <div class="detail-rule"></div>
                <p class="detail-message">游戏列表将在下一阶段接入</p>
            </div>
            <div class="detail-art-frame">
                <img id="detail-image" src="icons/gbc-atomic-purple-simple.png"/>
            </div>
        </main>

        <footer id="home-footer" class="control-bar">
            <div class="control-hint">
                <span class="keycap keycap-wide">←　→</span>
                <span>切换机型</span>
            </div>
            <div class="control-hint primary-action">
                <span class="keycap keycap-round">A</span>
                <span>进入游戏库</span>
            </div>
            <div class="control-hint secondary-action">
                <span class="keycap keycap-round keycap-muted">B</span>
                <span>退出</span>
            </div>
        </footer>

        <footer id="detail-footer" class="control-bar">
            <div class="control-hint">
                <span class="keycap keycap-round">B</span>
                <span>返回选择机型</span>
            </div>
            <div class="detail-status">游戏库占位页面</div>
        </footer>
    </div>
</body>
</rml>
